# =============================================================================
# LEVELUP RWANDA — Environment Configuration Template
# Copy to .env for local development. Never commit .env or real secrets.
# In Google Cloud Run, inject sensitive values via Google Cloud Secret Manager.
# =============================================================================

# Runtime
NODE_ENV="development"
PORT="3000"
APP_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"
TRUST_PROXY="true"

# MySQL 8 / Aiven MySQL Connection
# Option A: Full connection URI (e.g., mysql://avnadmin:PASSWORD@host:port/levelup_rwanda?ssl-mode=REQUIRED)
MYSQL_URL=""

# Option B: Discrete connection fields (used if MYSQL_URL is empty)
MYSQL_HOST=""
MYSQL_PORT="3306"
MYSQL_USER=""
MYSQL_PASSWORD=""
MYSQL_DATABASE="levelup_rwanda"
MYSQL_CONNECTION_LIMIT="10"
MYSQL_CONNECT_TIMEOUT_MS="10000"

# Strict MySQL TLS Verification (Required for Aiven MySQL 8 in production)
# Provide either a filesystem path to the CA certificate, raw PEM text, or base64-encoded PEM
MYSQL_SSL_ENABLED="true"
MYSQL_SSL_REJECT_UNAUTHORIZED="true"
MYSQL_CA_CERT_PATH=""
MYSQL_CA_CERT=""
MYSQL_CA_CERT_BASE64=""

# Security & Session Management (Required in production: 32+ high-entropy chars, distinct values)
# Example: openssl rand -hex 32
SESSION_SECRET=""
CSRF_SECRET=""
SESSION_TTL_HOURS="168"
COOKIE_SECURE="auto"

# First-Administrator Provisioning
# One-time secret token used to authorize /api/v1/auth/bootstrap-admin when zero super_admins exist.
# Remove or rotate after provisioning the first administrator.
ADMIN_BOOTSTRAP_TOKEN=""

# File Uploads & Persistent Storage
# Use "local" only for local development. In Cloud Run production, "gcs" is required.
UPLOAD_STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"
MAX_UPLOAD_BYTES="5242880"

# Google Cloud Storage (Required when UPLOAD_STORAGE_DRIVER="gcs")
GCS_BUCKET_NAME=""
GCS_KEY_PREFIX="levelup-rwanda"
# Delivery mode: "proxy" (streams via permission-checked /api/v1/media/*) or "signed_url" (redirects to short-lived V4 signed URL)
GCS_DELIVERY_MODE="proxy"
GCS_SIGNED_URL_TTL_SECONDS="300"
# Optional public CDN/bucket origin added to Helmet CSP imgSrc if configured (must be https://)
GCS_PUBLIC_BASE_URL=""
UPLOAD_CDN_ORIGIN=""

# Optional Platform Integrations
GEMINI_API_KEY=""

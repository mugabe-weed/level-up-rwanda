{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && npm run build:server && npm run build:cli",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/server.js",
    "build:cli": "esbuild server/db/migrate-cli.ts server/db/seed-cli.ts server/db/bootstrap-admin-cli.ts --bundle --platform=node --format=esm --packages=external --outdir=dist-server --entry-names=[name]",
    "start": "node dist-server/server.js",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server server.js",
    "lint": "tsc --noEmit",
    "migrate": "tsx server/db/migrate-cli.ts",
    "migrate:status": "tsx server/db/migrate-cli.ts status",
    "migrate:dry-run": "tsx server/db/migrate-cli.ts dry-run",
    "migrate:prod": "node dist-server/migrate-cli.js",
    "seed": "tsx server/db/seed-cli.ts",
    "seed:prod": "node dist-server/seed-cli.js",
    "bootstrap-admin": "tsx server/db/bootstrap-admin-cli.ts",
    "bootstrap-admin:prod": "node dist-server/bootstrap-admin-cli.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@google-cloud/storage": "^9.0.0",
    "@google/genai": "^2.4.0",
    "@hookform/resolvers": "^7.0.7",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.108.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/multer": "^2.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hook-form": "^7.92.0",
    "react-router-dom": "^7.18.6",
    "supertest": "^7.3.2",
    "vite": "^8.3.0",
    "vitest": "^5.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
